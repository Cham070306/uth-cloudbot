{
  "info":{"name":"UTH CloudBot BE-02 / DB-01","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"baseUrl","value":"http://localhost:8080"},{"key":"demoToken","value":"demo-token-sv001"}],
  "item":[
