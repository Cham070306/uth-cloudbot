    {"name":"Chat kiến thức mở bằng Gemini","request":{"description":"Yêu cầu server chạy với GEMINI_ENABLED=true cùng API key và model hợp lệ.","method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"message\":\"Giải thích điện toán đám mây là gì\"}"},"url":"{{baseUrl}}/api/chat"}},
    {"name":"Chat fallback khi Gemini tắt","request":{"description":"Yêu cầu server chạy với GEMINI_ENABLED=false (mặc định). Kết quả phải có source.type=fallback và fallback_used=true.","method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"message\":\"Giải thích điện toán đám mây là gì\"}"},"url":"{{baseUrl}}/api/chat"}},
    {"name":"Chat unknown (Gemini hoặc fallback)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"message\":\"So sánh TCP và UDP\"}"},"url":"{{baseUrl}}/api/chat"}},
    {"name":"Chat intent lịch thi","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"message\":\"Lịch thi cuối kỳ ở đâu?\"}"},"url":"{{baseUrl}}/api/chat"}},
    {"name":"Login demo local","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"username\":\"sv001\",\"password\":\"demo123\"}"},"url":"{{baseUrl}}/api/auth/login"}},
    {"name":"Profile","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{demoToken}}"}],"url":"{{baseUrl}}/api/me"}},
    {"name":"Chat cá nhân","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{demoToken}}"}],"body":{"mode":"raw","raw":"{\"message\":\"Tôi còn bài tập nào chưa làm?\"}"},"url":"{{baseUrl}}/api/chat"}},
    {"name":"Tạo note","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{demoToken}}"}],"body":{"mode":"raw","raw":"{\"content\":\"Note demo local\"}"},"url":"{{baseUrl}}/api/me/notes"}},
    {"name":"Feedback mới","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"message_id\":\"demo-message-001\",\"helpful\":true}"},"url":"{{baseUrl}}/api/feedback"}},
    {"name":"Feedback legacy","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"question\":\"Câu hỏi demo\",\"answer\":\"Câu trả lời demo\",\"vote\":\"up\"}"},"url":"{{baseUrl}}/api/feedback"}},
    {"name":"Lỗi chat rỗng","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"message\":\"   \"}"},"url":"{{baseUrl}}/api/chat"}},
    {"name":"Lỗi token","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer invalid"}],"url":"{{baseUrl}}/api/me"}}
